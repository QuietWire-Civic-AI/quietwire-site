{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.quietwire.ai/schemas/editions-manifest-v1.schema.json",
  "title": "QuietWire Editions public-safe manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "editions"],
  "properties": {
    "schema_id": {"const": "quietwire.editions-manifest.v1"},
    "editions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edition_id",
          "release_state",
          "website_visibility",
          "title",
          "slug",
          "authors",
          "source_date",
          "artifact_type",
          "summary",
          "canonical_path",
          "body_file"
        ],
        "properties": {
          "edition_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96},
          "release_state": {"const": "approved"},
          "website_visibility": {"const": "listed"},
          "title": {"type": "string", "minLength": 1, "maxLength": 240},
          "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96},
          "authors": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
          "source_date": {"type": "string", "format": "date"},
          "artifact_type": {"enum": ["article", "essay", "report", "transcript", "audio", "video"]},
          "summary": {"type": "string", "minLength": 1, "maxLength": 500},
          "canonical_path": {"type": "string", "pattern": "^/editions/[a-z0-9]+(?:-[a-z0-9]+)*/$", "maxLength": 160},
          "body_file": {"type": "string", "pattern": "^exports/editions/[a-z0-9]+(?:-[a-z0-9]+)*\\.html$", "maxLength": 220}
        }
      }
    }
  }
}
